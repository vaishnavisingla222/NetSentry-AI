= pd.DataFrame(X_test).copy().reset_index(drop=True)\n","\n","if Xtr.shape[1] != Xte.shape[1]:\n","    raise ValueError(\"Training and test sets have different feature counts.\")\n","\n","if Xtr.shape[1] == Xte.shape[1] and list(Xtr.columns) != list(Xte.columns):\n","    Xte.columns = Xtr.columns\n","\n","Xtr = Xtr.apply(pd.to_numeric, errors=\"coerce\")\n","Xte = Xte.apply(pd.to_numeric, errors=\"coerce\")\n","\n","Xtr = Xtr.replace([np.inf, -np.inf], np.nan)\n","Xte = Xte.replace([np.inf, -np.inf], np.nan)\n","\n","# Remove columns that have no usable values in training.\n","valid_cols = Xtr.columns[Xtr.notna().any(axis=0)]\n","Xtr = Xtr[valid_cols]\n","Xte = Xte[valid_cols]\n","\n","print(\"Training data:\", Xtr.shape)\n","print(\"Testing data:\", Xte.shape)\n","print(\"Training attack rate:\", round(y_train_bin.mean(), 4))\n","print(\"Testing attack rate:\", round(y_test_bin.mean(), 4))\n","\n","# --------------------------------------------------\n","# 2. Define the models and leakage-safe pipelines\n","# --------------------------------------------------\n","\n","models = {\n","    \"XGBoost\": Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),\n","        (\"model\", XGBClassifier(\n","            n_estimators=200,\n","            max_depth=6,\n","            learning_rate=0.1,\n","            subsample=0.8,\n","            colsample_bytree=0.8,\n","            eval_metric=\"logloss\",\n","            random_state=42,\n","            n_jobs=-1\n","        ))\n","    ]),\n","\n","    \"Random Forest\": Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),\n","        (\"model\", RandomForestClassifier(\n","            n_estimators=200,\n","            random_state=42,\n","            n_jobs=-1,\n","            class_weight=\"balanced\"\n","        ))\n","    ]),\n","\n","    \"ANN\": Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),\n","        (\"scaler\", StandardScaler()),\n","        (\"model\", MLPClassifier(\n","            hidden_layer_sizes=(128, 64),\n","            max_iter=300,\n","            early_stopping=True,\n","            random_state=42\n","        ))\n","    ]),\n","\n","    \"Linear SVM\": Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),\n","        (\"scaler\", StandardScaler()),\n","        (\"model\", LinearSVC(\n","            class_weight=\"balanced\",\n","            max_iter=5000,\n","            random_state=42\n","        ))\n","    ])\n","}\n","\n","# --------------------------------------------------\n","# 3. Stratified 5-fold cross-validation\n","# --------------------------------------------------\n","# 1. Create a stratified sample for faster CV\n","sample_size = min(250_000, len(Xtr))\n","\n","X_cv, _, y_cv, _ = train_test_split(\n","    Xtr,\n","    y_train_bin,\n","    train_size=sample_size,\n","    stratify=y_train_bin,\n","    random_state=42\n",")\n","\n","print(\"CV sample shape:\", X_cv.shape)\n","print(\"CV attack rate:\", round(y_cv.mean(), 4))\n","\n","# 2. Configure 5-fold CV\n","cv = StratifiedKFold(\n","    n_splits=5,\n","    shuffle=True,\n","    random_state=42\n",")\n","\n","scoring = {\n","    \"accuracy\": \"accuracy\",\n","    \"precision\": \"precision\",\n","    \"recall\": \"recall\",\n","    \"f1\": \"f1\",\n","    \"roc_auc\": \"roc_auc\",\n","    \"ap\": \"average_precision\"\n","}\n","\n","# 3. Evaluate all four models\n","cv_results = []\n","\n","for name, model in models.items():\n","    print(f\"\\nRunning 5-fold CV: {name}\")\n","    start_time = time.perf_counter()\n","\n","    scores = cross_validate(\n","        model,\n","        X_cv,\n","        y_cv,\n","        cv=cv,\n","        scoring=scoring,\n","        n_jobs=1,\n","        return_train_score=False,\n","        error_score=\"raise\"\n","    )\n","\n","    row = {\"Model\": name}\n","\n","    for metric in scoring:\n","        values = scores[f\"test_{metric}\"]\n","        row[f\"{metric.upper()} Mean\"] = values.mean()\n","        row[f\"{metric.upper()} SD\"] = values.std(ddof=1)\n","\n","    row[\"Time (sec)\"] = round(\n","        time.perf_counter() - start_time, 2\n","    )\n","\n","    cv_results.append(row)\n","    print(f\"Completed in {row['Time (sec)']} seconds\")\n","\n","# 4. Display comparison\n","cv_df = pd.DataFrame(cv_results).sort_values(\n","    \"F1 Mean\", ascending=False\n",").reset_index(drop=True)\n","\n","display(\n","    cv_df.style.format({\n","        col: \"{:.4f}\"\n","        for col in cv_df.columns if col != \"Model\"\n","    })\n",")"]},{"cell_type":"code","execution_count":20,"id":"639808af","metadata":{"execution":{"iopub.execute_input":"2026-10-21T08:32:06.704467Z","iopub.status.busy":"2026-10-21T08:32:06.70393Z","iopub.status.idle":"2026-10-21T09:11:20.37997Z","shell.execute_reply":"2026-10-21T09:11:20.378888Z"},"papermill":{"duration":2354.013052,"end_time":"2026-10-21T09:11:20.388787+00:00","exception":false,"start_time":"2026-10-21T08:32:06.375735+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training and evaluating XGBoost...\n","Training and evaluating Random Forest...\n","Training and evaluating ANN...\n","Training and evaluating Linear SVM...\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Model</th>\n","      <th>Accuracy</th>\n","      <th>Attack Precision</th>\n","      <th>Attack Recall</th>\n","      <th>Attack F1</th>\n","      <th>ROC-AUC</th>\n","      <th>PR-AUC (AP)</th>\n","      <th>Training + prediction (sec)</th>\n","    </tr>\n","  </thead>\n","  <tbody>